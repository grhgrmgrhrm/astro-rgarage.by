---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const news = (await getCollection('news')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout title="Новости — СТО Ржавый Гараж" description="Новости и статьи автосервиса Ржавый Гараж в Минске. Полезная информация об услугах, акциях, ремонте автомобилей.">
  <section class="bg-garage-black text-garage-light py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-heading uppercase mb-4">Новости и статьи</h1>
      <p class="text-garage-light/70">Полезная информация об услугах автосервиса «Ржавый Гараж» в Минске.</p>
    </div>
  </section>

  <section class="py-12 bg-garage-gray">
    <div class="max-w-4xl mx-auto px-4 space-y-6">
      {news.map((item) => (
        <article class="bg-garage-black border border-garage-red/30 rounded-lg p-6">
          <time class="text-garage-red text-sm font-heading uppercase">{new Date(item.data.pubDate).toLocaleDateString('ru-RU')}</time>
          <h2 class="text-xl font-heading uppercase mt-2 mb-3">
            <a href={base + 'news/' + item.data.slug} class="text-garage-light hover:text-garage-red no-underline">
              {item.data.title}
            </a>
          </h2>
          <p class="text-garage-light/70">{item.data.description}</p>
          <a href={base + 'news/' + item.data.slug} class="inline-block mt-4 text-garage-red font-heading uppercase text-sm hover:text-garage-light no-underline">
            Читать далее →
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
