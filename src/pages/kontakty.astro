---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoursCard from '../components/HoursCard.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Контакты — Автосервис «Ржавый Гараж»"
  metaTitle="Контакты автосервиса в Минске — Ржавый Гараж"
  description="Контакты автосервиса «Ржавый Гараж» в Минске. Адрес, телефон, часы работы. Эвакуатор 24/7. ☎ +375 29 373-71-61"
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumbs -->
    <nav class="text-sm text-garage-muted mb-6">
      <a href={base} class="hover:text-garage-red">Главная</a>
      <span class="mx-2">/</span>
      <span class="text-garage-light">Контакты</span>
    </nav>

    <h1 class="mb-8">Контакты</h1>

    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div class="space-y-4">
        <div class="card-brutal">
          <h3 class="text-garage-red mb-2">Телефон</h3>
          <p class="text-lg">
            <a href="tel:+375293737161" class="text-garage-red font-heading font-bold text-2xl no-underline">
              +375 29 373-71-61
            </a>
          </p>
        </div>

        <div class="card-brutal">
          <h3 class="text-garage-red mb-2">Адрес</h3>
          <p class="text-garage-light">Беларусь, Минск, Передовая ул., д. 6, корп. 12</p>
        </div>

        <div class="card-brutal">
          <h3 class="text-garage-red mb-2">Эвакуатор</h3>
          <p class="text-garage-light">Круглосуточно — 24/7</p>
          <p class="text-garage-red text-sm mt-1">От 50 BYN по Минску</p>
        </div>

        <div class="card-brutal">
          <h3 class="text-garage-red mb-2">Мы в соцсетях</h3>
          <div class="flex gap-4">
            <a href="https://www.instagram.com/rgarage_cto/" target="_blank" rel="noopener" class="text-garage-light hover:text-garage-red no-underline">Instagram</a>
            <a href="https://vk.com/sto.rzhavyy.garazh" target="_blank" rel="noopener" class="text-garage-light hover:text-garage-red no-underline">VK</a>
          </div>
        </div>
      </div>

      <HoursCard />
    </div>

    <!-- Map -->
    <section class="section-brutal mt-8">
      <h2>Как нас найти</h2>
      <div class="mt-6 border-2 border-garage-light/10 shadow-brutal-sm overflow-hidden">
        <iframe
          src="https://www.google.com/maps?q=Минск,+Передовая+ул.+6&output=embed"
          width="100%"
          height="400"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Карта — автосервис Ржавый Гараж, Минск, Передовая ул. 6"
        ></iframe>
      </div>
    </section>
  </div>
</BaseLayout>
