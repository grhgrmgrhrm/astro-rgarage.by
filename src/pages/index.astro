---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import Stats from '../components/Stats.astro';
import ServiceCards from '../components/ServiceCards.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import HoursCard from '../components/HoursCard.astro';

const services = await getCollection('services');
const featured = services.filter((s) => s.data.featured).slice(0, 6);

const categories = [
  {
    slug: 'slesarnye', name: 'Слесарные работы', image: '/images/services/car-engine-diagnostic.jpg',
    popular: [
      { slug: 'slesarnye-raboty', title: 'Слесарные работы' },
      { slug: 'zamena-masla', title: 'Замена масла' },
      { slug: 'zamena-remnya-grm', title: 'Замена ремня ГРМ' },
    ],
  },
  {
    slug: 'diagnostics', name: 'Диагностика', image: '/images/services/car-engine-diagnostic.jpg',
    popular: [
      { slug: 'diagnostika-dvigatelya', title: 'Диагностика двигателя' },
      { slug: 'diagnostika-podveski', title: 'Диагностика подвески' },
      { slug: 'diagnostika-i-remont-tormoznoj-sistemy-protochka-tormoznyh-diskov', title: 'Диагностика тормозов' },
    ],
  },
  {
    slug: 'evakuator', name: 'Эвакуатор', image: '/images/services/tow-truck.jpg',
    popular: [
      { slug: 'evakuaciya-legkovyh-avtomobilej', title: 'Эвакуация легковых' },
      { slug: 'evakuaciya-gruzovyh-avtomobilej', title: 'Эвакуация грузововых' },
      { slug: 'evakuaciya-minivenov-i-mikroavtobusov', title: 'Эвакуация микроавтобусов' },
    ],
  },
  {
    slug: 'avtoelektrika', name: 'Автоэлектрика', image: '/images/services/car-engine-diagnostic.jpg',
    popular: [
      { slug: 'avtoelektrika', title: 'Автоэлектрика' },
      { slug: 'elektrovelosipedy', title: 'Ремонт электровелосипедов' },
      { slug: 'elektrosamokaty-i-elektroskutery', title: 'Ремонт электросамокатов' },
    ],
  },
  {
    slug: 'kuzov', name: 'Кузовной ремонт', image: '/images/services/car-painting.jpg',
    popular: [
      { slug: 'polirovka-pokraska-avto', title: 'Полировка и покраска' },
      { slug: 'antikorrozijnaya-obrabotka-avtomobilya', title: 'Антикоррозийная обработка' },
      { slug: 'podbor-avtoemalej', title: 'Подбор автоэмалей' },
    ],
  },
  {
    slug: 'shinomontazh', name: 'Шиномонтаж', image: '/images/services/car-suspension-brakes.jpg',
    popular: [
      { slug: 'shinomontazh', title: 'Шиномонтаж и балансировка' },
    ],
  },
  {
    slug: 'turbin', name: 'Ремонт турбин', image: '/images/services/turbocharger.jpg',
    popular: [
      { slug: 'remont-turbin', title: 'Ремонт турбин' },
    ],
  },
  {
    slug: 'services', name: 'Доп. услуги', image: '/images/services/motor-oil.jpg',
    popular: [
      { slug: 'originalnye-masla-po-samym-nizkim-cenam', title: 'Моторные масла' },
      { slug: 'promyvka-forsunok', title: 'Промывка форсунок' },
      { slug: 'proverka-avto-pered-pokupkoj', title: 'Проверка авто перед покупкой' },
    ],
  },
];

const featuredCards = featured.map((s) => ({
  href: `/uslugi/${s.data.slug}`,
  title: s.data.title.replace(/\s+в Минске\s*$/i, '').trim(),
  desc: s.data.description.slice(0, 100),
  price: s.data.priceFrom,
}));

const stats = [
  { n: '10+', lbl: 'лет на рынке' },
  { n: '5000+', lbl: 'ремонтов выполнено' },
  { n: '24/7', lbl: 'эвакуатор' },
  { n: 'все', lbl: 'марки авто' },
];

const steps = [
  { title: 'Звонок', desc: 'Звоните или приезжаете — описываете проблему. Бесплатная консультация.' },
  { title: 'Диагностика', desc: 'Опытные мастера проводят диагностику и называют точную цену ремонта.' },
  { title: 'Ремонт', desc: 'Качественные запчасти, прозрачные сроки. Вы контролируете процесс.' },
  { title: 'Гарантия', desc: 'Гарантия на все работы. Забираете исправный авто без сюрпризов.' },
];

const testimonials = [
  { quote: 'Привёз машину с проблемой — сделали быстро и недорого. Цена совпала с названной по телефону, никаких сюрпризов.', name: 'Андрей', role: 'Mitsubishi Lancer' },
  { quote: 'Эвакуатор приехал через 20 минут ночью. Довезли до сервиса, на следующий день отремонтировали. Спасибо!', name: 'Сергей', role: 'Volkswagen Passat' },
  { quote: 'Обслуживаем автопарк компании у них уже 3 года. Безнал, документы, приоритет. Всё чётко.', name: 'Игорь', role: 'Корпоративный клиент' },
  { quote: 'Менял ремень ГРМ — сделали за день. Предложили заодно поменять помпу, правильно, что согласился. Цена адекватная.', name: 'Дмитрий', role: 'BMW X3' },
  { quote: 'Диагностика подвески — всё показали на подъёмнике, объяснили что срочно, а что нет. Не навязывали лишнего.', name: 'Ольга', role: 'Toyota Corolla' },
  { quote: 'Покрасили бампер после ДТП — цвет подобрали идеально, не отличить от заводского. Сделали за 2 дня.', name: 'Павел', role: 'Mazda CX-5' },
  { quote: 'Замена масла — быстро, недорого. Масло было своё, установили без проблем. Записался на ТО через месяц.', name: 'Алексей', role: 'Ford Focus' },
  { quote: 'Эвакуировал машину из Борисова в Минск — приехали вовремя, водитель аккуратный. Цена как договаривались.', name: 'Виктор', role: 'Renault Megane' },
  { quote: 'Ремонтировали турбину — другие сервисы говорили «меняй», а эти отремонтировали. Сэкономил прилично.', name: 'Роман', role: 'Audi A6' },
  { quote: 'Автоэлектрика — искали короткое замыкание два дня, нашли и устранили. Мастера знают своё дело.', name: 'Елена', role: 'Opel Astra' },
];
---

<BaseLayout
  title="Автосервис «Ржавый Гараж» в Минске"
  metaTitle="Автосервис «Ржавый Гараж» в Минске — ремонт, диагностика, эвакуатор 24/7"
  description="Автосервис в Минске: ремонт, диагностика, эвакуация. Все марки авто. Слесарные работы, кузовной ремонт, автоэлектрика. ☎ +375 29 373-71-61"
>
  <!-- Hero -->
  <section class="tq-hero">
    <img src="/images/sto.jpg" alt="Автосервис Ржавый Гараж" class="absolute inset-0 w-full h-full object-cover" />
    <div class="tq-scrim"></div>
    <div class="tq-hero-inner">
      <div class="tq-wrap">
        <h2 class="tq-hero-brand">Ржавый Гараж</h2>
        <h1 class="tq-hero-subhead">
          Качественный ремонт автомобилей в Минске. Ремонт, диагностика,
          эвакуация — 24/7. Все марки авто. От 50 BYN.
        </h1>
        <div class="tq-cta-row">
          <a href="tel:+375293737161" class="tq-btn">☎ +375 29 373-71-61</a>
          <a href="/uslugi" class="tq-btn ghost on-dark">Все услуги</a>
        </div>
        <div class="tq-trust-strip">
          <span class="dot"></span><span>Гарантия на работы</span>
          <span class="dot"></span><span>Опытные мастера</span>
          <span class="dot"></span><span>Безналичный расчёт</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <Stats items={stats} dark={true} />

  <!-- Categories with images -->
  <section class="tq-section cream">
    <div class="tq-wrap">
      <div class="tq-section-head center">
        <p class="tq-eyebrow">Услуги</p>
        <h2>Что мы делаем</h2>
        <p>Полный спектр услуг по ремонту и обслуживанию автомобилей любых марок.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {categories.map((cat) => (
          <div class="cat-card group relative overflow-hidden border-2 border-garage-light/10 shadow-brutal-sm hover:border-garage-red transition-colors flex flex-col">
            <a
              href={`/kategoriya/${cat.slug}`}
              class="relative overflow-hidden block no-underline"
            >
              <img
                src={cat.image}
                alt={cat.name}
                class="w-full h-32 object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-garage-black/50"></div>
              <h3 class="absolute inset-0 flex items-center justify-center text-garage-red text-lg text-center px-2 no-underline">{cat.name}</h3>
            </a>
            <ul class="cat-card-list bg-garage-gray p-3 space-y-1 flex-1">
              {cat.popular.map((svc) => (
                <li>
                  <a href={`/uslugi/${svc.slug}`} class="no-underline">
                    <h4 class="text-garage-light hover:text-garage-red text-xs font-body font-normal normal-case tracking-normal leading-snug transition-colors">
                      {svc.title}
                    </h4>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured services -->
  {featuredCards.length > 0 && (
    <section class="tq-section">
      <div class="tq-wrap">
        <div class="tq-section-head center">
          <p class="tq-eyebrow">Популярное</p>
          <h2>Популярные услуги</h2>
        </div>
        <ServiceCards items={featuredCards} />
      </div>
    </section>
  )}

  <!-- Process steps -->
  <ProcessSteps steps={steps} dark={true} />

  <!-- Testimonials -->
  <Testimonials items={testimonials} dark={false} />

  <!-- CTA -->
  <CtaBanner
    title="Нужна помощь с авто?"
    text="Звоните прямо сейчас — бесплатно проконсультируем и назовём цену. Работаем без выходных."
    phone="+375293737161"
  />

  <!-- Contacts with hours -->
  <section class="tq-section cream">
    <div class="tq-wrap">
      <div class="tq-section-head center">
        <p class="tq-eyebrow">Контакты</p>
        <h2>Где мы находимся</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div class="space-y-4">
          <div class="card-brutal">
            <h3 class="text-garage-red mb-2">Телефон</h3>
            <p class="text-lg"><a href="tel:+375293737161" class="text-garage-red font-heading font-bold text-2xl no-underline">+375 29 373-71-61</a></p>
          </div>
          <div class="card-brutal">
            <h3 class="text-garage-red mb-2">Адрес</h3>
            <p class="text-garage-light">Беларусь, Минск, Передовая ул., д. 6, корп. 12</p>
          </div>
          <div class="card-brutal">
            <h3 class="text-garage-red mb-2">Эвакуатор</h3>
            <p class="text-garage-light">Круглосуточно — 24/7</p>
            <p class="text-garage-red text-sm mt-1">От 50 BYN по Минску</p>
          </div>
        </div>
        <HoursCard />
      </div>
    </div>
  </section>
</BaseLayout>
