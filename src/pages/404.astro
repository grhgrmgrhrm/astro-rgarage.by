---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 — Страница не найдена | СТО Ржавый Гараж" description="Страница не найдена. Услуги СТО Ржавый Гараж в Минске.">
  <section class="py-20 bg-garage-gray min-h-[60vh] flex items-center">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <div class="text-garage-red font-heading text-8xl mb-6">404</div>
      <h1 class="font-heading uppercase text-3xl mb-4">Страница не найдена</h1>
      <p class="text-garage-light/70 mb-8">Возможно, страница была перемещена или удалена. Попробуйте найти нужное в разделах ниже.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href={base} class="btn-brutal">Главная</a>
        <a href={base + 'uslugi'} class="btn-brutal">Услуги</a>
        <a href={base + 'news'} class="btn-brutal">Новости</a>
        <a href={base + 'kontakty'} class="btn-brutal">Контакты</a>
      </div>
      <p class="text-garage-light/50 text-sm mt-10">☎ <a href="tel:+375293737161" class="text-garage-red hover:text-garage-light">+375 29 373-71-61</a></p>
    </div>
  </section>
</BaseLayout>
