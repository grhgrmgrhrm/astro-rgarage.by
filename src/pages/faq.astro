---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';

const generalFaq = [
  {
    q: 'Где находится автосервис «Ржавый Гараж»?',
    a: 'Мы находимся по адресу: Беларусь, Минск, Передовая ул., д. 6, корп. 12. Работаем без выходных с 08:00 до 20:00. Эвакуатор доступен круглосуточно — 24/7.',
  },
  {
    q: 'Какой номер телефона автосервиса?',
    a: 'Звоните: ☎ +375 29 373-71-61. Бесплатно проконсультируем, назовём ориентировочную стоимость ремонта и подберём удобное время для визита.',
  },
  {
    q: 'Какие марки автомобилей вы ремонтируете?',
    a: 'Обслуживаем все марки авто — отечественные и иномарки, легковые, коммерческие, микроавтобусы и грузовики до 3,5 тонн. Работаем с автомобилями любого года выпуска.',
  },
  {
    q: 'Даёте ли вы гарантию на работы?',
    a: 'Да, мы предоставляем гарантию на все виды работ. Срок гарантии зависит от типа ремонта — уточняйте у мастера. Используем только качественные запчасти и расходные материалы.',
  },
  {
    q: 'Можно ли приехать без записи?',
    a: 'Да, можно. Но для экономии времени рекомендуем предварительно позвонить: ☎ +375 29 373-71-61. Так мы сможем подготовить мастера и запчасти к вашему приезду.',
  },
  {
    q: 'Вы работаете с юридическими лицами?',
    a: 'Да, мы обслуживаем корпоративные автопарки. Безналичный расчёт, закрывающие документы, договор с фиксированными ценами. Подробнее — на странице «Юридическим лицам».',
  },
  {
    q: 'Нужно ли покупать запчасти самостоятельно?',
    a: 'Нет, не нужно. У нас есть большинство расходников и запчастей в наличии. Также можем привезти под заказ. Если хотите — можете принести свои запчасти, мы установим.',
  },
  {
    q: 'Сколько стоит диагностика?',
    a: 'Стоимость диагностики зависит от вида: диагностика двигателя — от 30 BYN, диагностика подвески — от 20 BYN, компьютерная диагностика — от 25 BYN. Точную цену назовём по телефону.',
  },
];

const servicesFaq = [
  {
    q: 'Сколько стоит эвакуатор по Минску?',
    a: 'Эвакуация легкового автомобиля по Минску — от 50 BYN. Стоимость зависит от расстояния, времени суток и веса автомобиля. Эвакуатор работает круглосуточно — 24/7. Звоните: ☎ +375 29 373-71-61.',
  },
  {
    q: 'Делаете ли вы эвакуацию за городом?',
    a: 'Да, мы эвакуируем автомобили по всей Минской области и Беларуси. Стоимость зависит от расстояния. Например, эвакуация в Заславль — от 70 BYN, в Борисов — от 120 BYN. Уточняйте по телефону.',
  },
  {
    q: 'Сколько стоит замена масла?',
    a: 'Замена моторного масла с фильтром — от 15 BYN (работа). Масло можно купить у нас или принести своё. Для такси действует акция — от 7 BYN. Замена масла в АКПП — от 30 BYN.',
  },
  {
    q: 'Сколько стоит замена ремня ГРМ?',
    a: 'Стоимость замены ремня ГРМ зависит от марки автомобиля и сложности работ — от 80 BYN. При замене ГРМ рекомендуем одновременно поменять ролики и помпу. Точную цену назовём после осмотра.',
  },
  {
    q: 'Делаете ли вы кузовной ремонт и покраску?',
    a: 'Да, мы выполняем кузовной ремонт любой сложности: локальная покраска, полная покраска, антикоррозийная обработка, подбор автоэмалей. Покраска одного элемента — от 120 BYN.',
  },
  {
    q: 'Ремонтируете ли вы турбины?',
    a: 'Да, мы ремонтируем турбины любых автомобилей. Диагностика турбины — от 30 BYN. Ремонт зависит от степени износа — от 150 BYN. Даём гарантию на ремонт турбины.',
  },
  {
    q: 'Можно ли пройти техосмотр у вас?',
    a: 'Мы не проводим официальный техосмотр, но можем подготовить автомобиль к прохождению ТО: проверить тормоза, подвеску, свет, выхлопную систему. Предрейсовый осмотр — от 20 BYN.',
  },
  {
    q: 'Делаете ли вы предпродажную подготовку авто?',
    a: 'Да, мы проводим предпродажную подготовку: диагностика, полировка кузова, химчистка салона, мелкий ремонт. Стоимость зависит от объёма работ — от 80 BYН. Уточняйте по телефону.',
  },
];

const paymentFaq = [
  {
    q: 'Какие способы оплаты вы принимаете?',
    a: 'Мы принимаем наличные, банковские карты, безналичный расчёт для юридических лиц. Также возможна оплата через ЕРИП. Для корпоративных клиентов — отсрочка платежа по договору.',
  },
  {
    q: 'Можно ли оплатить ремонт по безналичному расчёту?',
    a: 'Да, мы работаем с юридическими лицами по безналу. Предоставляем все необходимые закрывающие документы: акт выполненных работ, счёт-фактуру, договор. Подробнее — на странице «Юридическим лицам».',
  },
  {
    q: 'Выдаёте ли вы документы для страховой?',
    a: 'Да, мы предоставляем все необходимые документы для страховой компании: заказ-наряд, акт выполненных работ, фотографии повреждений. Обратитесь к мастеру — поможем оформить.',
  },
  {
    q: 'Можно ли отремонтировать авто в рассрочку?',
    a: 'К сожалению, рассрочку мы не предоставляем. Оплата производится по факту выполнения работ. Для постоянных клиентов и корпоративных заказчиков возможны индивидуальные условия.',
  },
];
---

<BaseLayout
  title="Вопросы и ответы — Автосервис «Ржавый Гараж»"
  metaTitle="FAQ — частые вопросы об автосервисе в Минске | Ржавый Гараж"
  description="Ответы на частые вопросы: где находится автосервис, сколько стоит ремонт, эвакуатор, замена масла. Все марки авто. ☎ +375 29 373-71-61"
>
  <!-- Hero -->
  <section class="tq-section dark">
    <div class="tq-wrap narrow">
      <p class="tq-eyebrow">Помощь</p>
      <h1 style="color: var(--color-white); font-family: var(--font-heading); font-weight: 600; text-transform: uppercase; font-size: clamp(2.4rem, 5vw, 4rem); line-height: .98; margin: 0 0 var(--space-5);">
        Вопросы и ответы
      </h1>
      <p style="font-size: var(--text-xl); color: rgba(255,255,255,.92); line-height: var(--leading-relaxed); max-width: 68ch;">
        Собрали ответы на самые частые вопросы об автосервисе, ценах, эвакуаторе
        и условиях работы. Не нашли ответ — позвоните: ☎ +375 29 373-71-61.
      </p>
    </div>
  </section>

  <!-- General FAQ -->
  <FaqAccordion items={generalFaq} dark={true} />

  <!-- Services FAQ -->
  <div class="tq-section cream">
    <div class="tq-wrap narrow">
      <div class="tq-section-head center" style="margin-bottom: var(--space-8);">
        <p class="tq-eyebrow">Услуги и цены</p>
        <h2 style="color: var(--color-dark);">Стоимость услуг</h2>
      </div>
      <div class="tq-acc" data-acc>
        {servicesFaq.map((item) => (
          <div class="tq-acc-item" data-acc-item>
            <button class="tq-acc-q" data-acc-q aria-expanded="false">{item.q}</button>
            <div class="tq-acc-a">{item.a}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Payment FAQ -->
  <FaqAccordion items={paymentFaq} dark={true} />

  <!-- CTA -->
  <CtaBanner
    title="Не нашли ответ?"
    text="Позвоните — бесплатно проконсультируем по любому вопросу. Работаем без выходных с 08:00 до 20:00."
    phone="+375293737161"
  />
</BaseLayout>
