---
import '../styles/global.css';
import '../styles/components.css';

interface Props {
  title: string;
  metaTitle?: string;
  description?: string;
  image?: string;
}

const { title, metaTitle, description, image } = Astro.props;
const pageTitle = metaTitle || title;
const ogImage = image ? new URL(image, Astro.site) : undefined;
