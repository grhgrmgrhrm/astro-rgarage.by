  <!-- Insert soft hyphens after Russian prefixes for reliable word breaking -->
  <script>
    (function () {
      // Prefixes that are natural break points in Russian compound words
      const prefixes = [
        'электро', 'авто', 'шино', 'мото', 'турбо', 'макро', 'микро',
        'много', 'мало', 'вело', 'газо', 'бензо', 'дизель', 'гидро',
        'пневмо', 'термо', 'крио', 'фото', 'видео', 'аэро', 'кварто',
      ];

      // Match words that start with a prefix and are 13+ chars total
      // (prefix + 7+ chars after). Short words stay unbroken.
      const prefixRe = new RegExp(
        '\\b(' + prefixes.join('|') + ')([а-яё]{7,})\\b',
        'gi'
      );

      // Walk text nodes in h1-h4, insert shy; after prefix
      const walker = document.createTreeWalker(
        document.body,
        NodeFilter.SHOW_TEXT,
        {
          acceptNode: (node) => {
            const parent = node.parentElement;
            if (!parent) return NodeFilter.FILTER_REJECT;
            const tag = parent.tagName;
            if (tag === 'H1' || tag === 'H2' || tag === 'H3' || tag === 'H4') {
              return prefixRe.test(node.textContent || '')
                ? NodeFilter.FILTER_ACCEPT
                : NodeFilter.FILTER_REJECT;
            }
            return NodeFilter.FILTER_REJECT;
          },
        }
      );

      const nodes: Text[] = [];
      let n: Node | null;
      while ((n = walker.nextNode())) nodes.push(n as Text);

      nodes.forEach((node) => {
        const text = node.textContent || '';
        // 1. Insert shy; after known prefixes in long words (13+ chars)
        prefixRe.lastIndex = 0;
        let newText = text.replace(prefixRe, '$1\u00AD$2');
        // 2. For remaining words 13+ chars without a prefix, insert shy; in the middle
        newText = newText.replace(/\b([а-яё]{13,})\b/gi, (word) => {
          // Skip if already has a shy; (from prefix step)
          if (word.includes('\u00AD')) return word;
          const mid = Math.floor(word.length / 2);
          return word.slice(0, mid) + '\u00AD' + word.slice(mid);
        });
        if (newText !== text) node.textContent = newText;
      });
    })();
  </script>
  <script>
    (function () {
      const toggle = document.querySelector('[data-nav-toggle]');
      const nav = document.querySelector('[data-mobile-nav]');
      const overlay = document.querySelector('[data-nav-overlay]');
      const panel = document.querySelector('[data-nav-panel]');
      const closeBtn = document.querySelector('[data-nav-close]');
      const links = document.querySelectorAll('[data-nav-link]');
      const burgerLines = document.querySelectorAll('[data-burger-line]');
      let lastFocused = null;

      if (!toggle || !nav || !panel) return;

      const open = () => {
        lastFocused = document.activeElement;
        nav.classList.remove('pointer-events-none');
        nav.setAttribute('aria-hidden', 'false');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Закрыть меню');
        requestAnimationFrame(() => {
          overlay?.classList.add('opacity-100');
          panel.classList.remove('translate-x-full');
        });
        document.body.style.overflow = 'hidden';
        // Burger → X
        if (burgerLines.length === 3) {
          burgerLines[0].classList.add('translate-y-2', 'rotate-45');
          burgerLines[1].classList.add('opacity-0');
          burgerLines[2].classList.add('-translate-y-2', '-rotate-45');
        }
        // Focus first link
        setTimeout(() => closeBtn?.focus(), 100);
      };

      const close = () => {
        overlay?.classList.remove('opacity-100');
        panel.classList.add('translate-x-full');
        nav.setAttribute('aria-hidden', 'true');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Открыть меню');
        document.body.style.overflow = '';
        // X → burger
        if (burgerLines.length === 3) {
          burgerLines[0].classList.remove('translate-y-2', 'rotate-45');
          burgerLines[1].classList.remove('opacity-0');
          burgerLines[2].classList.remove('-translate-y-2', '-rotate-45');
        }
        // Delay pointer-events-none until animation ends
        setTimeout(() => nav.classList.add('pointer-events-none'), 200);
        lastFocused?.focus();
      };

      toggle.addEventListener('click', () => {
        const isOpen = nav.getAttribute('aria-hidden') === 'false';
        isOpen ? close() : open();
      });

      closeBtn?.addEventListener('click', close);
      overlay?.addEventListener('click', close);

      links.forEach((link) => link.addEventListener('click', close));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.getAttribute('aria-hidden') === 'false') {
          close();
        }
      });

      // Close on resize to desktop
      const mq = window.matchMedia('(min-width: 768px)');
      mq.addEventListener('change', (e) => { if (e.matches) close(); });
    })();
  </script>
