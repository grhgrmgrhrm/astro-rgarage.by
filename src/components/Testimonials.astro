---
/**
 * Testimonial Slider — адаптация torque-and-tally
 * Usage:
 *   <Testimonials items={[{quote:"...",name:"...",role:"..."}, ...]} />
 */
interface Testimonial { quote: string; name: string; role?: string }
interface Props { items: Testimonial[]; dark?: boolean }
const { items, dark = false } = Astro.props;
---

<div class:list={["tq-section", { dark }]}>
  <div class="tq-wrap">
    <div class="tq-section-head center">
      <p class="tq-eyebrow">Отзывы</p>
      <h2>Что говорят клиенты</h2>
    </div>
    <div class="tq-ts-stage" data-ts>
      {items.map((t, i) => (
        <div class:list={["tq-ts-slide", { active: i === 0 }]} data-ts-slide>
          <blockquote>{t.quote}</blockquote>
          <div class="who">
            <b>{t.name}</b>
            {t.role && <span>{t.role}</span>}
          </div>
        </div>
      ))}
      <div class="tq-ts-dots" data-ts-dots>
        {items.map((_, i) => (
          <button class:list={["tq-ts-dot", { active: i === 0 }]} data-ts-dot={i} aria-label={`Отзыв ${i + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-ts]').forEach((stage) => {
    const slides = Array.from(stage.querySelectorAll('[data-ts-slide]'));
    const dots = Array.from(stage.querySelectorAll('[data-ts-dot]'));
    if (slides.length <= 1) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;
    const interval = 6000;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle('active', i === current));
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    };

    const start = () => { timer = setInterval(() => show(current + 1), interval); };
    const stop = () => clearInterval(timer);

    dots.forEach((d) => {
      d.addEventListener('click', () => {
        show(parseInt(d.getAttribute('data-ts-dot') || '0'));
        stop(); start();
      });
    });

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!prefersReduced) start();
  });
</script>
