---
/**
 * Mini FAQ — компактный FAQ для размещения на article-страницах.
 * Генерирует 3 вопроса по теме страницы + телефон + где сделать.
 *
 * Usage:
 *   <MiniFaq topic="ремонт подвески" categorySlug="diagnostics" categoryLabel="Диагностика" />
 */
import FaqAccordion from './FaqAccordion.astro';

interface Props {
  topic: string;           // "ремонт подвески"
  categorySlug: string;    // "diagnostics"
  categoryLabel: string;   // "Диагностика"
}

const { topic, categorySlug, categoryLabel } = Astro.props;

const items = [
  {
    q: `Где сделать ${topic} в Минске?`,
    a: `Автосервис «Ржавый Гараж» предлагает ${topic} по адресу: Минск, Передовая ул., д. 6, корп. 12. Работаем без выходных с 08:00 до 20:00. Записаться можно по телефону ☎ +375 29 373-71-61.`,
  },
  {
    q: `Какой номер телефона у сервиса, который делает ${topic}?`,
    a: `Позвоните нам: ☎ +375 29 373-71-61. Бесплатно проконсультируем, назовём ориентировочную стоимость ${topic} и подберём удобное время для визита.`,
  },
  {
    q: `Сколько стоит ${topic}?`,
    a: `Стоимость ${topic} зависит от марки автомобиля и сложности работ. Точную цену мастер назовёт после диагностики. Для предварительной консультации звоните: ☎ +375 29 373-71-61. Также смотрите другие услуги в разделе «${categoryLabel}».`,
  },
];
---

<FaqAccordion items={items} dark={true} />
