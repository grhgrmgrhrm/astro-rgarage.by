---
/**
 * Before/After slider — адаптация torque-and-tally
 * Usage:
 *   <BeforeAfter before="/images/before.jpg" after="/images/after.jpg" />
 */
interface Props {
  before: string;
  after: string;
  beforeLabel?: string;
  afterLabel?: string;
  note?: string;
}
const {
  before,
  after,
  beforeLabel = 'До',
  afterLabel = 'После',
  note,
} = Astro.props;
---

<div class="tq-wrap narrow">
  <div class="tq-ba-stage" data-ba>
    <div class="tq-ba-after">
      <img src={after} alt={afterLabel} />
    </div>
    <div class="tq-ba-before" data-ba-before>
      <img src={before} alt={beforeLabel} />
    </div>
    <span class="tq-ba-tag b">{beforeLabel}</span>
    <span class="tq-ba-tag a">{afterLabel}</span>
    <div class="tq-ba-divider" data-ba-divider></div>
    <div class="tq-ba-handle" data-ba-handle>⇄</div>
  </div>
  {note && <p class="tq-ba-note">{note}</p>}
</div>

<script>
  document.querySelectorAll('[data-ba]').forEach((stage) => {
    const before = stage.querySelector('[data-ba-before]') as HTMLElement;
    const divider = stage.querySelector('[data-ba-divider]') as HTMLElement;
    const handle = stage.querySelector('[data-ba-handle]') as HTMLElement;
    if (!before || !divider || !handle) return;

    let dragging = false;

    const setPos = (clientX: number) => {
      const rect = stage.getBoundingClientRect();
      let pct = ((clientX - rect.left) / rect.width) * 100;
      pct = Math.max(0, Math.min(100, pct));
      before.style.width = pct + '%';
      divider.style.left = pct + '%';
      handle.style.left = pct + '%';
    };

    stage.addEventListener('pointerdown', (e) => {
      dragging = true;
      setPos(e.clientX);
    });
    window.addEventListener('pointermove', (e) => {
      if (dragging) setPos(e.clientX);
    });
    window.addEventListener('pointerup', () => { dragging = false; });

    // keyboard
    handle.setAttribute('tabindex', '0');
    handle.setAttribute('role', 'slider');
    handle.addEventListener('keydown', (e) => {
      const cur = parseFloat(before.style.width || '50');
      if (e.key === 'ArrowLeft') setPos(stage.getBoundingClientRect().left + (cur - 2) / 100 * stage.getBoundingClientRect().width);
      if (e.key === 'ArrowRight') setPos(stage.getBoundingClientRect().left + (cur + 2) / 100 * stage.getBoundingClientRect().width);
    });

    // init 50%
    setPos(stage.getBoundingClientRect().left + stage.getBoundingClientRect().width / 2);
  });
</script>
