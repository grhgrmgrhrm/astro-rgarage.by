---
/**
 * CTA Banner — адаптация torque-and-tally
 * Usage:
 *   <CtaBanner title="..." text="..." phone="+375293737161" />
 */
interface Props {
  title: string;
  text?: string;
  phone?: string;
}
const { title, text, phone = '+375293737161' } = Astro.props;
const phoneDisplay = phone.replace(/^(\+375)(\d{2})(\d{3})(\d{2})(\d{2})$/, '$1 $2 $3-$4-$5');
---

<div class="tq-cta-banner">
  <div class="tq-wrap">
    <h2>{title}</h2>
    {text && <p>{text}</p>}
    <div class="tq-cta-row">
      <a href={`tel:${phone}`} class="tq-btn">☎ {phoneDisplay}</a>
      <a href="/kontakty" class="tq-btn ghost on-dark">Контакты</a>
    </div>
  </div>
</div>
