---
/**
 * Lightbox Gallery — адаптация torque-and-tally
 * Usage:
 *   <Lightbox images={[{src:"...",alt:"...",cap:"..."}, ...]} />
 */
interface Img { src: string; alt: string; cap?: string }
interface Props { images: Img[]; columns?: number }
const { images, columns = 4 } = Astro.props;
---

<div class="tq-wrap">
  <div class="tq-lb-grid" data-lb-grid style={`grid-template-columns:repeat(${columns},1fr)`}>
    {images.map((img, i) => (
      <button class="tq-lb-tile" data-lb-tile={i} aria-label={`Открыть фото: ${img.alt}`}>
        <img src={img.src} alt={img.alt} loading="lazy" />
        {img.cap && <span class="cap">{img.cap}</span>}
      </button>
    ))}
  </div>
</div>

<div class="tq-lb-modal" data-lb-modal aria-hidden="true">
  <button class="tq-lb-btn tq-lb-close" data-lb-close aria-label="Закрыть">×</button>
  <button class="tq-lb-btn tq-lb-prev" data-lb-prev aria-label="Предыдущее">‹</button>
  <img data-lb-img src="" alt="" />
  <button class="tq-lb-btn tq-lb-next" data-lb-next aria-label="Следующее">›</button>
  <div class="lb-cap" data-lb-cap></div>
</div>

<script>
  document.querySelectorAll('[data-lb-grid]').forEach((grid) => {
    const tiles = Array.from(grid.querySelectorAll('[data-lb-tile]'));
    const modal = document.querySelector('[data-lb-modal]') as HTMLElement;
    const img = modal?.querySelector('[data-lb-img]') as HTMLImageElement;
    const cap = modal?.querySelector('[data-lb-cap]') as HTMLElement;
    const close = modal?.querySelector('[data-lb-close]');
    const prev = modal?.querySelector('[data-lb-prev]');
    const next = modal?.querySelector('[data-lb-next]');
    if (!modal || !img) return;

    const data = tiles.map((t) => {
      const im = t.querySelector('img');
      return { src: im?.getAttribute('src') || '', alt: im?.getAttribute('alt') || '', cap: t.querySelector('.cap')?.textContent || '' };
    });

    let current = 0;
    let lastFocused: HTMLElement | null = null;

    const show = (n: number) => {
      current = (n + data.length) % data.length;
      img.src = data[current].src;
      img.alt = data[current].alt;
      if (cap) cap.textContent = data[current].cap;
    };

    const open = (i: number) => {
      lastFocused = document.activeElement as HTMLElement;
      show(i);
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      close?.setAttribute('tabindex', '0');
      (close as HTMLElement)?.focus();
    };

    const closeModal = () => {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastFocused?.focus();
    };

    tiles.forEach((t) => t.addEventListener('click', () => open(parseInt(t.getAttribute('data-lb-tile') || '0'))));
    close?.addEventListener('click', closeModal);
    prev?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));

    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('open')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  });
</script>
