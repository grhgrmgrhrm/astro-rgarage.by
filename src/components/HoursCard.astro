---
/**
 * Hours Card — адаптация torque-and-tally
 * Shows opening hours with live open/closed pill.
 */
const days = [
  { ru: 'Понедельник', short: 'ПН', open: '08:00', close: '20:00' },
  { ru: 'Вторник', short: 'ВТ', open: '08:00', close: '20:00' },
  { ru: 'Среда', short: 'СР', open: '08:00', close: '20:00' },
  { ru: 'Четверг', short: 'ЧТ', open: '08:00', close: '20:00' },
  { ru: 'Пятница', short: 'ПТ', open: '08:00', close: '20:00' },
  { ru: 'Суббота', short: 'СБ', open: '08:00', close: '20:00' },
  { ru: 'Воскресенье', short: 'ВС', open: '08:00', close: '20:00' },
];
const today = new Date().getDay(); // 0=Sun
const todayIdx = today === 0 ? 6 : today - 1;
---

<div class="tq-hours-card" data-hours>
  <div class="tq-hours-banner">
    <span class="panel-label">Часы работы</span>
    <span class="tq-pill" data-pill>—</span>
  </div>
  <table class="tq-hours-table">
    {days.map((d, i) => (
      <tr class:list={{ today: i === todayIdx }}>
        <td>{d.ru}</td>
        <td>{d.open}–{d.close}</td>
      </tr>
    ))}
  </table>
  <div class="tq-hours-foot">
    Без выходных. Возможны выезды эвакуатора вне рабочего времени по договорённости.
  </div>
</div>

<script>
  const card = document.querySelector('[data-hours]');
  const pill = card?.querySelector('[data-pill]') as HTMLElement;
  if (pill) {
    const now = new Date();
    const day = now.getDay(); // 0=Sun
    const idx = day === 0 ? 6 : day - 1;
    const hours = [
      { open: 480, close: 1200 }, // ПН 08:00–20:00
      { open: 480, close: 1200 },
      { open: 480, close: 1200 },
      { open: 480, close: 1200 },
      { open: 480, close: 1200 },
      { open: 480, close: 1200 },
      { open: 480, close: 1200 },
    ];
    const cur = now.getHours() * 60 + now.getMinutes();
    const span = hours[idx];
    const isOpen = cur >= span.open && cur < span.close;
    if (isOpen) {
      pill.textContent = 'Сейчас открыто';
      pill.classList.remove('closed');
    } else {
      pill.textContent = 'Сейчас закрыто';
      pill.classList.add('closed');
    }
  }
</script>
