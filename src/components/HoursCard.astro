---
/**
 * Hours Card — адаптация torque-and-tally
 * Shows opening hours with live open/closed pill.
 */
const days = [
  { ru: 'Понедельник', short: 'ПН', open: '09:00', close: '18:00' },
  { ru: 'Вторник', short: 'ВТ', open: '09:00', close: '18:00' },
  { ru: 'Среда', short: 'СР', open: '09:00', close: '18:00' },
  { ru: 'Четверг', short: 'ЧТ', open: '09:00', close: '18:00' },
  { ru: 'Пятница', short: 'ПТ', open: '09:00', close: '18:00' },
  { ru: 'Суббота', short: 'СБ', open: null, close: null },
  { ru: 'Воскресенье', short: 'ВС', open: null, close: null },
];
const today = new Date().getDay(); // 0=Sun
const todayIdx = today === 0 ? 6 : today - 1;
---

<div class="tq-hours-card" data-hours>
  <div class="tq-hours-banner">
    <span class="panel-label">Часы работы</span>
    <span class="tq-pill" data-pill>—</span>
  </div>
  <table class="tq-hours-table">
    {days.map((d, i) => (
      <tr class:list={{ today: i === todayIdx }}>
        <td>{d.ru}</td>
        <td>{d.open ? `${d.open}–${d.close}` : 'Выходной'}</td>
      </tr>
    ))}
  </table>
  <div class="tq-hours-foot">
    ПН–ПТ 09:00–18:00. Суббота и воскресенье — выходные. Эвакуатор доступен вне рабочего времени по договорённости.
  </div>
</div>

<script>
  const card = document.querySelector('[data-hours]');
  const pill = card?.querySelector('[data-pill]') as HTMLElement;
  if (pill) {
    const now = new Date();
    const day = now.getDay(); // 0=Sun
    const idx = day === 0 ? 6 : day - 1;
    // ПН–ПТ 09:00–18:00, СБ–ВС закрыто
    const hours = [
      { open: 540, close: 1080 },  // ПН 09:00–18:00
      { open: 540, close: 1080 },  // ВТ
      { open: 540, close: 1080 },  // СР
      { open: 540, close: 1080 },  // ЧТ
      { open: 540, close: 1080 },  // ПТ
      { open: null, close: null }, // СБ
      { open: null, close: null }, // ВС
    ];
    const cur = now.getHours() * 60 + now.getMinutes();
    const span = hours[idx];
    const isOpen = span.open !== null && cur >= span.open && cur < span.close;
    if (isOpen) {
      pill.textContent = 'Сейчас открыто';
      pill.classList.remove('closed');
    } else {
      pill.textContent = 'Сейчас закрыто';
      pill.classList.add('closed');
    }
  }
</script>
